#!/bin/sh
set -eu

for package in astroberry-os-sysmod astroberry-manager indi-bin phd2 openssh-server calamares calamares-settings-debian grub-pc-bin grub-efi-amd64-bin; do
    if ! dpkg-query -W -f='${db:Status-Status}\n' "$package" 2>/dev/null | grep -qx installed; then
        echo "ERROR: required package is missing: $package" >&2
        exit 1
    fi
done

# Astroberry must come from its own repository, not a Debian package of the same name.
for package in astroberry-manager astroberry-os-sysmod phd2; do
    if ! apt-cache policy "$package" | grep -q 'astroberry.io'; then
        echo "ERROR: $package is not available from the astroberry.io repository." >&2
        exit 1
    fi
done

# KStars/EKOS is deliberately not part of this image; it must not arrive as a
# dependency or recommendation of something else.
for package in kstars kstars-bleeding; do
    if dpkg-query -W -f='${db:Status-Status}\n' "$package" 2>/dev/null | grep -qx installed; then
        echo "ERROR: $package is installed but is not wanted in this image." >&2
        exit 1
    fi
done

# brltty interferes with USB-serial astronomy devices. Astroberry is meant to
# stay unmodified, so report loudly rather than silently hiding the finding;
# the image still removes it.
if dpkg-query -W -f='${db:Status-Status}\n' brltty 2>/dev/null | grep -qx installed; then
    echo "WARNING: brltty was pulled in by the Astroberry install; purging it." >&2
    mkdir -p /usr/share/galileo
    echo "brltty was installed by astroberry-os and purged by the smoke build" > /usr/share/galileo/brltty-purged.txt
    apt-get purge --yes brltty
fi

for binary in /usr/bin/indiserver /usr/bin/phd2; do
    if ! command -v "$binary" >/dev/null 2>&1; then
        echo "ERROR: expected program is missing: $binary" >&2
        exit 1
    fi
    if ldd "$binary" | grep -q 'not found'; then
        echo "ERROR: unresolved shared libraries for $binary:" >&2
        ldd "$binary" | grep 'not found' >&2
        exit 1
    fi
done

systemctl enable ssh.service || true
