[Unit]
Description=Galileo desktop session (Openbox) on the virtual display
Requires=galileo-vnc.service
After=galileo-vnc.service

[Service]
User=astro
Group=astro
Environment=DISPLAY=:1
Environment=HOME=/home/astro
WorkingDirectory=/home/astro
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'until [ -S /tmp/.X11-unix/X1 ]; do sleep 0.5; done'
ExecStart=/usr/bin/openbox-session
Restart=on-failure

[Install]
WantedBy=multi-user.target
