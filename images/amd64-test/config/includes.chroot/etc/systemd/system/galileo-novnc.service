[Unit]
Description=Galileo noVNC web client (HTTPS on port 6080)
Requires=galileo-vnc.service
After=galileo-vnc.service

[Service]
User=astro
Group=astro
ExecStartPre=+/usr/local/sbin/galileo-vnc-init
ExecStart=/usr/bin/websockify --web=/usr/share/novnc --cert=/var/lib/galileo/vnc/novnc.pem --ssl-only 6080 localhost:5901
Restart=on-failure

[Install]
WantedBy=multi-user.target
