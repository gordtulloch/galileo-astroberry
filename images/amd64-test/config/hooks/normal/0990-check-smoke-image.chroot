#!/bin/sh
set -eu

if dpkg-query -W -f='${db:Status-Status}\n' brltty 2>/dev/null | grep -qx installed; then
    echo "ERROR: brltty must not be installed in the Galileo Linux smoke image." >&2
    exit 1
fi

for package in openssh-server network-manager avahi-daemon tigervnc-standalone-server openbox novnc websockify; do
    if ! dpkg-query -W -f='${db:Status-Status}\n' "$package" 2>/dev/null | grep -qx installed; then
        echo "ERROR: required package is missing: $package" >&2
        exit 1
    fi
done

for command in indiserver phd2 /usr/bin/Xtigervnc /usr/bin/openbox-session; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "ERROR: required program is missing from the image: $command" >&2
        exit 1
    fi
done

# Dynamic linking problems in the staged builds would otherwise only surface
# at runtime on the target.
for binary in /usr/bin/indiserver /usr/bin/phd2; do
    if ldd "$binary" | grep -q 'not found'; then
        echo "ERROR: unresolved shared libraries for $binary:" >&2
        ldd "$binary" | grep 'not found' >&2
        exit 1
    fi
done

systemctl enable ssh.service
systemctl enable NetworkManager.service
systemctl enable avahi-daemon.service
