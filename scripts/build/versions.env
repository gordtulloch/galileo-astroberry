# Upstream pins for the stable channel. INDI and INDI-3rdparty must always use
# the same release so drivers match the core libraries (PSD INDI-06).
# The nightly channel ignores these pins and builds each repository's default
# branch.
INDI_STABLE_REF="v2.2.5"
INDI_3RDPARTY_STABLE_REF="v2.2.5"
PHD2_STABLE_REF="v2.6.14"

INDI_URL="https://github.com/indilib/indi.git"
INDI_3RDPARTY_URL="https://github.com/indilib/indi-3rdparty.git"
PHD2_URL="https://github.com/OpenPHDGuiding/phd2.git"
