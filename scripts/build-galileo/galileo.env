# Upstream pin for the stable channel: the latest published Galileo release.
# The nightly channel builds the default branch (main).
GALILEO_STABLE_REF="v0.9.02alpha"
GALILEO_URL="https://github.com/gordtulloch/Galileo.git"

# Galileo lives in its own virtual environment so its Python dependencies never
# touch Debian's system Python packages.
GALILEO_VENV="${GALILEO_VENV:-/opt/galileo/venv}"
